// Schema CSDL. Xem docs/PLAN.md mục 3.
// Đặt tên: "phiên đăng nhập" = AuthSession, "phiên tạo ảnh/phiên tư vấn" = ConsultSession.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SALE
  MKT // phòng marketing: quản lý bài đăng, nhóm, kết nối extension của module Lead Facebook (D91)
}

enum PromptKind {
  CATALOG
  DESIGN
}

enum SessionType {
  CATALOG
  DESIGN
}

enum ImageKind {
  SHEET
  DESIGN
}

enum ZaloDeliveryStatus {
  SENT
  FAILED
}

// Các "trục" phân loại chất liệu. Giá trị bên trong từng trục do admin quản lý ở bảng material_options.
enum MaterialOptionType {
  BASE_MATERIAL
  TECHNIQUE
  SURFACE_FINISH
  SURFACE_PATTERN
  COLOR_FAMILY
  STYLE_TAG
  SERIES
}

// Số lớp màu: ONE = một màu cho cả hai mặt, TWO = hai mặt khác màu
enum ColorCount {
  ONE
  TWO
}

enum ImageStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(SALE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authSessions      AuthSession[]
  ownedCustomers    Customer[]       @relation("CustomerOwner")
  createdCustomers  Customer[]       @relation("CustomerCreator")
  createdBrands     Brand[]
  createdLogos      Logo[]
  consultSessions   ConsultSession[]
  generatedImages   GeneratedImage[]
  usageLogs         UsageLog[]
  promptTemplates   PromptTemplate[]
  zaloStaff         ZaloContact[]
  zaloBotTasks      ZaloBotTask[]
  quotes            Quote[]
  fbAccounts        FbAccount[]
  extTokens         ExtToken[]
  assignedFbLeads   FbLead[]         @relation("FbLeadAssignee")
  registeredFbPosts FbPost[]         @relation("FbPostRegistrar")

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Material {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String
  groupName          String
  printTech          String
  descHuman          String    @db.Text
  descAi             String?   @db.Text // đã bỏ khỏi giao diện, không còn dùng; giữ cột để không mất dữ liệu cũ
  thicknessMm        Float? // độ dày thật (mm); nhóm Mỏng / Cao thành / Dày tính từ số này, xem lib/materials/thickness.ts
  layer1Path         String?   @db.VarChar(500)
  layer2Path         String?   @db.VarChar(500)
  productPhotoPath   String?   @db.VarChar(500)
  referencePath      String?   @db.VarChar(500) // ảnh ghép lớp 1 + lớp 2, đây là ảnh gửi cho AI
  referenceUpdatedAt DateTime?
  kieRefUrl          String?   @db.VarChar(1000) // bộ nhớ đệm URL đã upload lên kie.ai
  kieRefExpiresAt    DateTime?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)

  // Phân loại (xem docs/DECISIONS.md D73). Các cột *value* lưu "value" của bảng material_options, không dùng khóa ngoại.
  // groupName và printTech vẫn là nguồn mà code cũ đọc: khi lưu, hệ thống ghi song song nhãn của baseMaterial và technique vào hai cột đó.
  baseMaterial         String?            @db.VarChar(60)
  technique            String?            @db.VarChar(60)
  surfaceFinish        String?            @db.VarChar(60) // chất bề mặt: mờ, bóng, gương, nhũ...
  surfacePattern       String?            @db.VarChar(60) // họa tiết: trơn, caro, hoa văn...
  colorCount           ColorCount?
  frontColorName       String?            @db.VarChar(100) // chữ tự do, tả đúng cái nhìn thấy
  frontColorFamily     String?            @db.VarChar(60)
  frontColorConfidence String?            @db.VarChar(20) // CAO | TRUNG_BINH | THAP
  backColorName        String?            @db.VarChar(100)
  backColorFamily      String?            @db.VarChar(60)
  backColorConfidence  String?            @db.VarChar(20)
  seriesCode           String?            @db.VarChar(60) // dòng nhà cung cấp: ZY, HT, H...
  aiVisualNote         String?            @db.Text // 1 câu tiếng Anh tả bề mặt hai mặt cho AI (chưa đưa vào prompt)
  photoIssue           String?            @db.VarChar(200) // vấn đề ảnh mẫu, nối bằng "|": CO_THUOC, CO_TAY, NEN_LAN, MAU_LECH, MO, KHONG_THAY_CHAT_LIEU
  classifyConfidence   String?            @db.VarChar(20) // độ tin cậy của lần phân loại: CAO | TRUNG_BINH | THAP
  needsReview          Boolean            @default(false)
  reviewNote           String?            @db.Text
  styleTags            MaterialStyleTag[]

  // Tấm vật liệu để xếp logo và báo giá (xem docs/DECISIONS.md D88). Đơn vị mm; trống = chưa có dữ liệu, chưa tính được giá.
  stockWidthMm  Float?
  stockHeightMm Float?
  stockPrice    Decimal? @db.Decimal(14, 2) // giá một tấm
  edgeMarginMm  Float? // lề tấm
  gapMm         Float? // khoảng cách giữa logo; trống = dùng mặc định chung
  allowRotate   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sheetMaterials  SheetMaterial[]
  selectedIn      SessionSelectedMaterial[]
  generatedImages GeneratedImage[]
  quotes          Quote[]

  @@index([groupName, isActive])
  @@index([baseMaterial])
  @@index([technique])
  @@index([surfaceFinish])
  @@index([surfacePattern])
  @@index([colorCount])
  @@index([needsReview])
  @@map("materials")
}

// Danh mục giá trị cho các trường phân loại chất liệu (admin thêm/sửa nhãn/tắt). "value" là mã không dấu, không đổi sau khi tạo.
model MaterialOption {
  id        String             @id @default(cuid())
  type      MaterialOptionType
  value     String             @db.VarChar(60)
  label     String             @db.VarChar(100)
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([type, value])
  @@unique([type, label])
  @@index([type, isActive, sortOrder])
  @@map("material_options")
}

// Tag phong cách của chất liệu (nhiều-nhiều). value là value của MaterialOption loại STYLE_TAG.
model MaterialStyleTag {
  materialId String
  value      String   @db.VarChar(60)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([materialId, value])
  @@index([value])
  @@map("material_style_tags")
}

model Sheet {
  id          String   @id @default(cuid())
  name        String
  groupName   String   @default("")
  cols        Int      @default(2)
  rows        Int      @default(5)
  aspectRatio String   @default("2:3")
  resolution  String   @default("2K")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // trang mẫu mặc định: dùng cho nút "Tạo nhanh" (không cần chọn trang mẫu)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials       SheetMaterial[]
  generatedImages GeneratedImage[]

  @@map("sheets")
}

model SheetMaterial {
  id         String @id @default(cuid())
  sheetId    String
  materialId String
  position   Int // 0, 1, 2... theo thứ tự đọc (trái sang phải, trên xuống dưới)

  sheet    Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([sheetId, position])
  @@unique([sheetId, materialId])
  @@index([materialId])
  @@map("sheet_materials")
}

model PromptTemplate {
  id          String     @id @default(cuid())
  kind        PromptKind
  version     Int
  body        String     @db.Text
  isActive    Boolean    @default(false)
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  createdBy       User?            @relation(fields: [createdById], references: [id])
  generatedImages GeneratedImage[]

  @@unique([kind, version])
  @@index([kind, isActive])
  @@map("prompt_templates")
}

model DesignStyle {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generatedImages GeneratedImage[]

  @@map("design_styles")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  note        String?  @db.Text
  ownerId     String // sale phụ trách
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User     @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdBy User     @relation("CustomerCreator", fields: [createdById], references: [id])
  brands    Brand[]
  fbLeads   FbLead[]

  @@index([name])
  @@index([phone])
  @@index([ownerId])
  @@map("customers")
}

model Brand {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  logos     Logo[]

  @@index([customerId])
  @@index([name])
  @@map("brands")
}

model Logo {
  id             String    @id @default(cuid())
  brandId        String
  originalPath   String    @db.VarChar(500)
  normalizedPath String    @db.VarChar(500)
  width          Int
  height         Int
  note           String?   @db.Text
  kieUrl         String?   @db.VarChar(1000)
  kieExpiresAt   DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand     Brand            @relation(fields: [brandId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  sessions  ConsultSession[]
  geometry  LogoGeometry?
  quotes    Quote[]

  @@index([brandId])
  @@map("logos")
}

model ConsultSession {
  id                  String      @id @default(cuid())
  type                SessionType
  logoId              String
  parentId            String? // phiên DESIGN trỏ về phiên CATALOG
  productType         String?
  variantsPerMaterial Int?
  note                String?     @db.Text
  createdById         String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  logo              Logo                      @relation(fields: [logoId], references: [id])
  parent            ConsultSession?           @relation("SessionParent", fields: [parentId], references: [id])
  children          ConsultSession[]          @relation("SessionParent")
  createdBy         User                      @relation(fields: [createdById], references: [id])
  selectedMaterials SessionSelectedMaterial[]
  images            GeneratedImage[]
  zaloBotTasks      ZaloBotTask[]
  quotes            Quote[]

  @@index([logoId])
  @@index([parentId])
  @@index([createdById, createdAt])
  @@map("consult_sessions")
}

model SessionSelectedMaterial {
  id         String @id @default(cuid())
  sessionId  String
  materialId String

  session  ConsultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])

  @@unique([sessionId, materialId])
  @@map("session_selected_materials")
}

model GeneratedImage {
  id               String      @id @default(cuid())
  sessionId        String
  kind             ImageKind
  sheetId          String?
  materialId       String?
  designStyleId    String?
  variantIndex     Int         @default(0)
  layoutSnapshot   Json // cột, hàng, danh sách (vị trí, mã, tên chất liệu) lúc tạo
  promptUsed       String      @db.Text
  promptTemplateId String?
  promptVersion    Int?
  model            String
  resolution       String
  aspectRatio      String
  taskId           String?
  status           ImageStatus @default(PENDING)
  attempt          Int         @default(1)
  lastPolledAt     DateTime?
  originalPath     String?     @db.VarChar(500)
  finalPath        String?     @db.VarChar(500)
  errorMessage     String?     @db.Text
  costCredits      Float? // credits nhà cung cấp đã trừ cho ảnh này (nếu có thông tin)
  parentImageId    String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  session        ConsultSession   @relation(fields: [sessionId], references: [id])
  sheet          Sheet?           @relation(fields: [sheetId], references: [id])
  material       Material?        @relation(fields: [materialId], references: [id])
  designStyle    DesignStyle?     @relation(fields: [designStyleId], references: [id])
  promptTemplate PromptTemplate?  @relation(fields: [promptTemplateId], references: [id])
  parentImage    GeneratedImage?  @relation("ImageRetry", fields: [parentImageId], references: [id])
  retries        GeneratedImage[] @relation("ImageRetry")
  createdBy      User             @relation(fields: [createdById], references: [id])
  usageLogs      UsageLog[]
  zaloDeliveries ZaloDelivery[]
  zaloPosts      ZaloPost[]

  @@index([status, lastPolledAt])
  @@index([sessionId])
  @@index([createdById])
  @@map("generated_images")
}

model UsageLog {
  id        String    @id @default(cuid())
  userId    String
  imageId   String?
  kind      ImageKind
  day       String    @db.VarChar(10) // YYYY-MM-DD theo múi giờ APP_TIMEZONE
  createdAt DateTime  @default(now())

  user  User            @relation(fields: [userId], references: [id])
  image GeneratedImage? @relation(fields: [imageId], references: [id])

  @@index([userId, day])
  @@index([day])
  @@map("usage_logs")
}

// Nhóm Zalo mà bot được mời vào. chatId là "chat.id" bot nhận được từ webhook (hoặc admin nhập tay).
model ZaloGroup {
  id          String    @id @default(cuid())
  chatId      String    @unique @db.VarChar(100)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  autoSend    Boolean   @default(false) // không còn dùng (đã bỏ tự động gửi ảnh vào nhóm khi tạo xong, D86); giữ cột để khỏi phải đổi cấu trúc dữ liệu
  lastSeenAt  DateTime? // lần cuối bot nhận được tin từ nhóm này
  insight     String?   @db.Text // mô tả nhóm (khách là ai, quan tâm gì...) để AI lên kịch bản chăm sóc phù hợp
  careEnabled Boolean   @default(false) // true = AI lên kịch bản chăm sóc cho nhóm này
  postsPerDay Int       @default(2) // số lượt đăng mỗi ngày (2-3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries ZaloDelivery[]
  posts      ZaloPost[]

  @@map("zalo_groups")
}

// Mỗi ảnh gửi vào mỗi nhóm đúng một dòng (để tự động gửi không bị gửi trùng, và xem được lý do lỗi).
model ZaloDelivery {
  id        String             @id @default(cuid())
  imageId   String
  groupId   String
  status    ZaloDeliveryStatus
  messageId String?            @db.VarChar(100)
  error     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  image GeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  group ZaloGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([imageId, groupId])
  @@index([groupId, createdAt])
  @@map("zalo_deliveries")
}

enum ZaloAccountStatus {
  CONNECTED // đang nghe tin
  CONNECTING // đang kết nối (vừa đăng nhập hoặc vừa khởi động máy chủ)
  DISCONNECTED // đã ngắt (bị ngắt tay, mở nơi khác, mất mạng...)
  LOGGED_OUT // phiên đăng nhập hết hạn: cần quét QR lại
}

// Tài khoản Zalo CÁ NHÂN đăng nhập bằng QR (thư viện không chính thức zca-js). Mỗi tài khoản có một kết nối nghe tin riêng
// và mọi hội thoại của nó gom về Hộp thư chung. Thông tin đăng nhập (cookie, imei) được mã hóa trước khi lưu.
model ZaloAccount {
  id              String            @id @default(cuid())
  uid             String?           @unique @db.VarChar(40) // mã người dùng Zalo, để đăng nhập lại cùng một số thì cập nhật chứ không tạo mới
  name            String            @db.VarChar(150)
  phone           String?           @db.VarChar(30)
  avatarUrl       String?           @db.VarChar(500)
  credentials     String?           @db.Text // JSON đã mã hóa (lib/crypto/secret-box.ts)
  status          ZaloAccountStatus @default(DISCONNECTED)
  lastError       String?           @db.Text
  lastConnectedAt DateTime?
  autoConnect     Boolean           @default(true) // true = máy chủ tự kết nối lại khi khởi động
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contacts ZaloContact[]

  @@map("zalo_accounts")
}

enum ZaloContactRole {
  CUSTOMER // khách nhắn bot (mặc định)
  STAFF // nhân viên/chủ đã ghép nối: dùng được lệnh gõ nhanh
  BLOCKED // bị chặn: lưu tin nhưng bot không trả lời
}

enum ZaloMessageDirection {
  IN
  OUT
}

enum ZaloMessageAuthor {
  CONTACT // người nhắn tới bot
  BOT // bot AI tự trả lời
  HUMAN // nhân viên (tin cũ từ Hộp thư đã bỏ)
  SYSTEM // tin lệnh/ghép nối do hệ thống trả
}

enum ZaloMessageKind {
  TEXT
  IMAGE
  FILE
  VOICE
  STICKER
  OTHER
}

// Mỗi người (hoặc nhóm) đã nhắn cho bot Zalo là một "hội thoại" (lưu để bot đọc ngữ cảnh, ghép nối nhân viên, thống kê).
model ZaloContact {
  id              String          @id @default(cuid())
  chatId          String          @unique @db.VarChar(100)
  chatType        String          @default("PRIVATE") @db.VarChar(20) // PRIVATE | GROUP
  displayName     String          @db.VarChar(150)
  role            ZaloContactRole @default(CUSTOMER)
  pairCode        String?         @db.VarChar(10) // mã ghép nối 4 số đang chờ admin cho phép
  pairRequestedAt DateTime?
  botPaused       Boolean         @default(false) // true = bot im ở hội thoại này (đã chuyển nhân viên hoặc khách gõ /nhanvien)
  botPausedAt     DateTime? // lúc bot bắt đầu im; quá "botResumeHours" thì bot tự trả lời lại
  needsHuman      Boolean         @default(false) // bot bí hoặc khách đòi gặp nhân viên
  unreadCount     Int             @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?         @db.VarChar(200)
  contextResetAt  DateTime? // lệnh /reset: bot không đọc tin cũ hơn mốc này
  accountId       String? // có giá trị = hội thoại của một tài khoản Zalo cá nhân (chatId lúc đó là "p:<accountId>:<threadId>"); trống = của bot
  threadId        String?         @db.VarChar(100) // mã cuộc chat thật trên Zalo cá nhân (người hoặc nhóm)
  avatarUrl       String?         @db.VarChar(500)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userId String? // nhân viên (role STAFF) gắn với tài khoản web nào: lệnh trong nhóm chạy dưới tên và hạn mức của người này

  account  ZaloAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user     User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages ZaloMessage[]

  @@index([accountId, lastMessageAt])
  @@index([lastMessageAt])
  @@index([role])
  @@map("zalo_contacts")
}

model ZaloMessage {
  id               String               @id @default(cuid())
  contactId        String
  direction        ZaloMessageDirection
  author           ZaloMessageAuthor
  kind             ZaloMessageKind      @default(TEXT)
  text             String?              @db.Text
  mediaPath        String?              @db.VarChar(500) // ảnh đã tải về kho lưu trữ
  zaloMessageId    String?              @unique @db.VarChar(100) // chống xử lý trùng khi Zalo gửi lại webhook
  authorUserId     String? // nhân viên trả lời từ web
  failed           Boolean              @default(false)
  error            String?              @db.Text
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime             @default(now())

  contact ZaloContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([author, createdAt])
  @@map("zalo_messages")
}

enum ZaloPostKind {
  TEXT
  IMAGE
  VIDEO
}

enum ZaloPostStatus {
  PLANNED // đã lên kịch bản, chờ tới giờ hoặc chờ bấm đăng
  SENDING
  SENT
  FAILED
  SKIPPED // người dùng bỏ qua
}

// Thư viện ảnh/video do người dùng tải lên để dùng trong kịch bản chăm sóc (ví dụ mẫu mã sản phẩm mới).
model ZaloAsset {
  id          String       @id @default(cuid())
  kind        ZaloPostKind // IMAGE hoặc VIDEO
  title       String       @db.VarChar(150)
  description String?      @db.Text // mô tả để AI biết nên dùng khi nào
  path        String       @db.VarChar(500)
  mimeType    String       @db.VarChar(100)
  sizeBytes   Int
  createdById String
  createdAt   DateTime     @default(now())

  posts ZaloPost[]

  @@index([createdAt])
  @@map("zalo_assets")
}

// Một lượt đăng trong kịch bản chăm sóc nhóm Zalo: AI lên sẵn nội dung và giờ, người dùng chỉnh được, rồi đăng.
model ZaloPost {
  id             String         @id @default(cuid())
  groupId        String
  scheduledAt    DateTime
  kind           ZaloPostKind
  text           String         @db.Text
  assetId        String?
  imageId        String? // ảnh đã tạo trong hệ thống (mẫu mã mới)
  status         ZaloPostStatus @default(PLANNED)
  reason         String?        @db.VarChar(300) // vì sao AI chọn nội dung này (trời rét, dịp lễ...)
  error          String?        @db.Text
  sentAt         DateTime?
  aiGenerated    Boolean        @default(true)
  editedAt       DateTime?
  editedByUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  group ZaloGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  asset ZaloAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  image GeneratedImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([groupId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("zalo_posts")
}

enum ZaloBotTaskKind {
  CATALOG
  DESIGN
}

enum ZaloBotTaskStatus {
  RUNNING // đang tạo ảnh
  DELIVERING // ảnh xong, đang gửi lại vào cuộc chat
  DONE
  FAILED
}

// Việc nhân viên giao cho bot trong nhóm Zalo (tag bot): tạo phiên ảnh rồi gửi kết quả lại đúng cuộc chat đó.
model ZaloBotTask {
  id             String            @id @default(cuid())
  chatId         String            @db.VarChar(100) // cuộc chat nhận kết quả (nhóm hoặc chat riêng với bot)
  chatType       String            @default("GROUP") @db.VarChar(20)
  kind           ZaloBotTaskKind
  sessionId      String
  userId         String // tài khoản web chịu trách nhiệm (người ra lệnh)
  logoId         String?
  imageMessageId String?           @db.VarChar(40) // tin ảnh (ZaloMessage.id) đã dùng làm logo, để lệnh sau dùng lại logo thay vì tạo trùng
  status         ZaloBotTaskStatus @default(RUNNING)
  summary        String?           @db.Text
  error          String?           @db.Text
  createdAt      DateTime          @default(now())
  finishedAt     DateTime?

  session ConsultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id])

  @@index([chatId, createdAt])
  @@index([status])
  @@map("zalo_bot_tasks")
}

// ---------- Kho kiến thức cho AI (xem docs/DECISIONS.md D87) ----------

enum KnowledgeVisibility {
  PUBLIC // được nói với khách
  INTERNAL // chỉ sale và AI hỗ trợ sale
  ADMIN_ONLY // chỉ quản trị viên, không AI trò chuyện nào được đọc
}

enum KnowledgeStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum KnowledgeGapStatus {
  OPEN
  RESOLVED
}

// Hồ sơ doanh nghiệp: đúng một bản ghi (id = "main"). Tên xưởng nằm ở bảng settings (khóa workshopName) để chân ảnh và AI dùng chung một nguồn.
model BusinessProfile {
  id           String   @id
  tradeName    String?  @db.VarChar(200)
  intro        String?  @db.Text
  address      String?  @db.Text
  hours        String?  @db.Text
  hotline      String?  @db.VarChar(100)
  zalo         String?  @db.VarChar(200)
  fanpage      String?  @db.VarChar(300)
  website      String?  @db.VarChar(300)
  deliveryArea String?  @db.Text
  payment      String?  @db.Text
  // mức hiển thị của từng trường: { "address": "PUBLIC", ... }; thiếu = INTERNAL (kín hơn)
  visibility   Json
  updatedById  String?
  updatedAt    DateTime @updatedAt

  @@map("business_profile")
}

model KnowledgeArticle {
  id            String              @id @default(cuid())
  title         String              @db.VarChar(200)
  category      String              @db.VarChar(40)
  body          String              @db.Text
  visibility    KnowledgeVisibility @default(INTERNAL)
  tags          Json // mảng chữ
  status        KnowledgeStatus     @default(DRAFT)
  priority      Int                 @default(0) // lớn hơn = ưu tiên hơn khi phải chọn bài
  alwaysInclude Boolean             @default(false) // luôn đưa vào (nếu còn chỗ trong ngân sách của vai AI)
  effectiveFrom DateTime?
  updatedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  roles KnowledgeArticleRole[]

  @@index([status, visibility])
  @@index([category])
  @@map("knowledge_articles")
}

// Vai AI nào được dùng bài này (một dòng mỗi vai). Lọc ngay trong câu truy vấn.
model KnowledgeArticleRole {
  articleId String
  role      String           @db.VarChar(30)
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, role])
  @@index([role])
  @@map("knowledge_article_roles")
}

// Thông số tính giá, CHỈ ADMIN. Không hàm nào của AI trò chuyện đọc bảng này.
model PricingParam {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(60)
  label       String   @db.VarChar(200)
  value       Decimal? @db.Decimal(18, 4) // trống = chưa có dữ liệu
  unit        String?  @db.VarChar(40)
  note        String?  @db.Text
  sortOrder   Int      @default(0)
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("pricing_params")
}

// Mỗi lượt AI trả lời dùng kiến thức nào, để admin kiểm tra khi AI trả lời sai.
model KnowledgeUse {
  id         String   @id @default(cuid())
  role       String   @db.VarChar(30)
  question   String   @db.VarChar(500)
  usedIds    Json
  droppedIds Json
  unknown    Boolean  @default(false) // AI báo chưa có thông tin
  userId     String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([role, createdAt])
  @@map("knowledge_uses")
}

// Câu hỏi AI chưa trả lời được, gom theo nội dung để admin bổ sung kiến thức dần.
model KnowledgeGap {
  id                  String             @id @default(cuid())
  key                 String             @unique @db.VarChar(64) // băm của câu hỏi đã chuẩn hóa
  role                String             @db.VarChar(30)
  question            String             @db.VarChar(500)
  count               Int                @default(1)
  status              KnowledgeGapStatus @default(OPEN)
  resolvedByArticleId String?
  firstAskedAt        DateTime           @default(now())
  lastAskedAt         DateTime           @default(now())

  @@index([status, lastAskedAt])
  @@map("knowledge_gaps")
}

// ---------- Xếp logo trên tấm và báo giá sản xuất (xem docs/DECISIONS.md D88) ----------

enum QuoteStatus {
  DRAFT
  SENT // đã gửi khách
  WON // khách chốt
}

enum LastSheetPolicy {
  WHOLE_SHEET // tính cả tấm cuối
  PRO_RATA // tính theo phần dùng
}

// Thông số máy theo công nghệ (khóa theo giá trị technique của chất liệu). Mọi cột trống = chưa có dữ liệu. CHỈ ADMIN.
model MachineProfile {
  id                    String   @id @default(cuid())
  technique             String   @unique @db.VarChar(60)
  cutSpeedMmPerSec      Float?
  engraveSpeedMm2PerSec Float?
  setupMinutesPerJob    Float?
  sheetChangeMinutes    Float?
  machineCostPerHour    Decimal? @db.Decimal(14, 2)
  laborSecondsPerPiece  Float?
  laborCostPerHour      Decimal? @db.Decimal(14, 2)
  consumableCostPerM2   Decimal? @db.Decimal(14, 2) // vật tư theo diện tích logo (mực UV...), tùy chọn
  updatedById           String?
  updatedAt             DateTime @updatedAt

  @@map("machine_profiles")
}

// Cấu hình báo giá chung: đúng một bản ghi (id = "main"). CHỈ ADMIN.
model QuoteSettings {
  id                String           @id
  defaultGapMm      Float?
  lastSheetPolicy   LastSheetPolicy?
  marginTiers       Json // [{fromQty, toQty|null, markupPct}]: lãi cộng thêm trên giá vốn theo bậc số lượng
  displayQuantities Json // các mốc số lượng hiển thị, ví dụ [50,100,200,500,1000]
  roundTo           Int? // làm tròn đơn giá tới bội số này (đồng)
  engraveLevels     Json // {IT, VUA, NHIEU}: % diện tích logo được khắc
  configVersion     Int              @default(0) // tăng mỗi lần có thay đổi giá trị ảnh hưởng báo giá
  updatedById       String?
  updatedAt         DateTime         @updatedAt

  @@map("quote_settings")
}

// Lịch sử thay đổi thông số (tấm, máy, cấu hình giá).
model ConfigChangeLog {
  id          String   @id @default(cuid())
  entity      String   @db.VarChar(40) // MATERIAL_STOCK | MACHINE_PROFILE | QUOTE_SETTINGS
  entityId    String   @db.VarChar(60)
  entityLabel String   @db.VarChar(200)
  before      Json?
  after       Json
  userId      String
  createdAt   DateTime @default(now())

  @@index([entity, createdAt])
  @@index([createdAt])
  @@map("config_change_logs")
}

// Hình học logo (khung bao thật, đường viền, diện tích) tính một lần cho mỗi logo.
model LogoGeometry {
  logoId      String   @id
  geometry    Json
  algoVersion Int      @default(1)
  createdAt   DateTime @default(now())

  logo Logo @relation(fields: [logoId], references: [id], onDelete: Cascade)

  @@map("logo_geometry")
}

model Quote {
  id              String      @id @default(cuid())
  sessionId       String?
  logoId          String
  materialId      String
  logoWidthMm     Float
  logoHeightMm    Float
  engraveLevel    String      @db.VarChar(20)
  perSheet        Int
  efficiencyPct   Float
  nestingStrategy String      @db.VarChar(40)
  nestingLabel    String      @db.VarChar(300)
  placements      Json // bố cục đã chọn (vị trí từng logo trên tấm)
  status          QuoteStatus @default(DRAFT)
  configVersion   Int // phiên bản thông số lúc tính
  note            String?     @db.Text
  createdById     String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sentAt          DateTime?
  wonAt           DateTime?

  session   ConsultSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  logo      Logo               @relation(fields: [logoId], references: [id])
  material  Material           @relation(fields: [materialId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  lines     QuoteLine[]
  cost      QuoteCostSnapshot?

  @@index([logoId])
  @@index([sessionId])
  @@index([createdById, createdAt])
  @@index([status])
  @@map("quotes")
}

// Giá bán theo từng mốc số lượng (sale được xem).
model QuoteLine {
  id             String @id @default(cuid())
  quoteId        String
  quantity       Int
  sheetsNeeded   Int
  machineMinutes Float
  unitPrice      Int
  totalPrice     Int

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, quantity])
  @@map("quote_lines")
}

// Giá vốn và thông số lúc tính. CHỈ ADMIN: không được tải lên trình duyệt của sale.
model QuoteCostSnapshot {
  quoteId        String @id
  paramsSnapshot Json
  costDetail     Json

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@map("quote_cost_snapshots")
}

// Thời gian máy thực tế của các đơn đã làm, để hiệu chỉnh tốc độ cắt/khắc. CHỈ ADMIN.
model MachineTimeLog {
  id             String   @id @default(cuid())
  quoteId        String?
  description    String   @db.VarChar(300)
  technique      String   @db.VarChar(60)
  totalCutMm     Float
  engraveAreaMm2 Float
  sheets         Int
  actualMinutes  Float
  createdById    String
  createdAt      DateTime @default(now())

  @@index([technique, createdAt])
  @@map("machine_time_logs")
}

// ============================================================================================
// Module Lead Facebook (docs/thiet-ke-module-lead-facebook.md, quyết định D91).
// Giai đoạn 1: thu thập comment trên những bài người dùng chủ động theo dõi, tách số điện thoại, tạo lead.
// Extension chỉ ĐỌC trang và báo về; không có bảng hay trường nào dùng để tự gửi comment hay tự đăng bài.
// ============================================================================================

enum FbAccountStatus {
  ACTIVE
  PAUSED
  RESTRICTED // extension báo checkpoint / bị hạn chế: ngừng giao việc cho tới khi quản trị bật lại
}

enum FbGroupPurpose {
  FIND_CUSTOMER
  FIND_SUPPLIER
  BOTH
}

enum FbGroupStatus {
  ACTIVE
  PAUSED
  BANNED
}

enum FbPostPurpose {
  FIND_CUSTOMER
  FIND_SUPPLIER
}

enum FbTrackingStatus {
  TRACKING
  PAUSED
  DONE
}

enum FbCommentCategory {
  HAS_CONTACT
  INTEREST
  QUESTION
  OTHER
  SPAM
}

enum FbLeadType {
  CUSTOMER
  SUPPLIER
}

enum FbLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
  INVALID
}

enum ExtLogType {
  SCAN_OK
  SCAN_FAIL
  SELECTOR_BROKEN
  CHECKPOINT
  REPLY_SENT
  POST_DONE
}

// Nick Facebook của nhân sự dùng để mở và quét các bài đã đăng ký theo dõi.
model FbAccount {
  id          String          @id @default(cuid())
  userId      String
  displayName String          @db.VarChar(150)
  profileUrl  String          @db.VarChar(300)
  status      FbAccountStatus @default(ACTIVE)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user   User       @relation(fields: [userId], references: [id])
  posts  FbPost[]
  tokens ExtToken[]

  @@index([userId])
  @@map("fb_accounts")
}

model FbGroup {
  id        String         @id @default(cuid())
  name      String         @db.VarChar(200)
  url       String         @unique @db.VarChar(300)
  topic     String?        @db.VarChar(150)
  purpose   FbGroupPurpose @default(BOTH)
  notes     String?        @db.Text // quy định của nhóm, lưu ý admin
  status    FbGroupStatus  @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  posts FbPost[]
  leads FbLead[]

  @@map("fb_groups")
}

// Bài đã đăng cần theo dõi. Chỉ bài có trong bảng này mới được extension mở và đọc.
model FbPost {
  id                   String           @id @default(cuid())
  accountId            String
  groupId              String? // null nếu đăng trang cá nhân
  url                  String           @unique @db.VarChar(400) // permalink đã chuẩn hoá (lib/fb/urls.ts)
  contentSnapshot      String?          @db.Text
  purpose              FbPostPurpose
  postedAt             DateTime?
  trackingStatus       FbTrackingStatus @default(TRACKING)
  lastScannedAt        DateTime?
  lastFullScannedAt    DateTime? // lần gần nhất thực sự mở rộng và đọc comment; quét nhanh không đổi không cập nhật mốc này
  lastCommentAt        DateTime? // lần cuối thấy comment mới; quá N ngày không có thì tự chuyển DONE
  reportedCommentCount Int? // tổng comment Facebook công bố ở lần quét đầy đủ gần nhất
  commentCount         Int              @default(0)
  leadCount            Int              @default(0)
  registeredById       String? // người đã chủ động đăng ký bài này vào danh sách theo dõi
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  account      FbAccount   @relation(fields: [accountId], references: [id])
  group        FbGroup?    @relation(fields: [groupId], references: [id])
  registeredBy User?       @relation("FbPostRegistrar", fields: [registeredById], references: [id])
  comments     FbComment[]
  leads        FbLead[]

  @@index([accountId, trackingStatus, lastScannedAt])
  @@index([groupId])
  @@map("fb_posts")
}

model FbComment {
  id                String            @id @default(cuid())
  postId            String
  fbCommentId       String            @db.VarChar(100) // ID comment của Facebook, dùng chống trùng
  parentFbCommentId String?           @db.VarChar(100)
  authorName        String            @db.VarChar(200)
  authorProfileUrl  String?           @db.VarChar(500)
  isOwn             Boolean           @default(false) // do nick của mình viết
  text              String            @db.Text
  timeText          String?           @db.VarChar(60) // chuỗi thời gian nguyên văn ("2 giờ"), vì quy đổi ra giờ chỉ là ước chừng
  commentedAt       DateTime? // quy đổi từ timeText, có thể lệch
  category          FbCommentCategory @default(OTHER)
  extractedPhone    String?           @db.VarChar(20)
  extractedOther    Json? // { phones, zalo, emails, spelledOut }
  handled           Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  post    FbPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  lead    FbLead?
  sources FbLeadSource[]

  @@unique([postId, fbCommentId])
  @@index([category, createdAt])
  @@index([extractedPhone])
  @@map("fb_comments")
}

model FbLead {
  id           String       @id @default(cuid())
  commentId    String       @unique // comment đầu tiên sinh ra lead
  postId       String
  groupId      String?
  name         String       @db.VarChar(200)
  phone        String?      @unique @db.VarChar(20) // 0xxxxxxxxx; cùng số thì không tạo lead mới, chỉ thêm nguồn
  zalo         String?      @db.VarChar(20)
  email        String?      @db.VarChar(200)
  profileUrl   String?      @db.VarChar(500)
  leadType     FbLeadType
  status       FbLeadStatus @default(NEW)
  assignedToId String?
  customerId   String? // gắn tay vào khách hàng có sẵn (hệ thống chỉ gợi ý khi trùng số điện thoại)
  note         String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  comment    FbComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post       FbPost         @relation(fields: [postId], references: [id])
  group      FbGroup?       @relation(fields: [groupId], references: [id])
  assignedTo User?          @relation("FbLeadAssignee", fields: [assignedToId], references: [id])
  customer   Customer?      @relation(fields: [customerId], references: [id])
  sources    FbLeadSource[]

  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([postId])
  @@index([groupId])
  @@index([customerId])
  @@map("fb_leads")
}

// Mỗi comment có chứa liên hệ của một lead đúng một dòng (kể cả comment đầu tiên): để thống kê theo bài/nhóm cho đúng
// khi một khách để lại cùng số ở nhiều bài.
model FbLeadSource {
  id        String   @id @default(cuid())
  leadId    String
  commentId String   @unique
  createdAt DateTime @default(now())

  lead    FbLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  comment FbComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("fb_lead_sources")
}

// Mã kết nối extension: chỉ lưu băm (sha256), mã gốc hiện đúng một lần lúc tạo.
model ExtToken {
  id          String    @id @default(cuid())
  userId      String
  accountId   String
  tokenHash   String    @unique @db.VarChar(64)
  tokenPrefix String    @db.VarChar(16) // vài ký tự đầu để nhận ra mã trong danh sách, không đủ để dùng
  label       String    @db.VarChar(100)
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User      @relation(fields: [userId], references: [id])
  account FbAccount @relation(fields: [accountId], references: [id])
  logs    ExtLog[]

  @@index([userId])
  @@index([accountId])
  @@map("ext_tokens")
}

model ExtLog {
  id        String     @id @default(cuid())
  tokenId   String
  type      ExtLogType
  detail    Json?
  createdAt DateTime   @default(now())

  token ExtToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@index([tokenId, createdAt])
  @@index([type, createdAt])
  @@map("ext_logs")
}
