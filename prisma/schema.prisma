// Schema CSDL. Xem docs/PLAN.md mục 3.
// Đặt tên: "phiên đăng nhập" = AuthSession, "phiên tạo ảnh/phiên tư vấn" = ConsultSession.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  SALE
}

enum PromptKind {
  CATALOG
  DESIGN
}

enum SessionType {
  CATALOG
  DESIGN
}

enum ImageKind {
  SHEET
  DESIGN
}

enum ZaloDeliveryStatus {
  SENT
  FAILED
}

// Các "trục" phân loại chất liệu. Giá trị bên trong từng trục do admin quản lý ở bảng material_options.
enum MaterialOptionType {
  BASE_MATERIAL
  TECHNIQUE
  SURFACE_FINISH
  SURFACE_PATTERN
  COLOR_FAMILY
  STYLE_TAG
  SERIES
}

// Số lớp màu: ONE = một màu cho cả hai mặt, TWO = hai mặt khác màu
enum ColorCount {
  ONE
  TWO
}

enum ImageStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(SALE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authSessions     AuthSession[]
  ownedCustomers   Customer[]       @relation("CustomerOwner")
  createdCustomers Customer[]       @relation("CustomerCreator")
  createdBrands    Brand[]
  createdLogos     Logo[]
  consultSessions  ConsultSession[]
  generatedImages  GeneratedImage[]
  usageLogs        UsageLog[]
  promptTemplates  PromptTemplate[]

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Material {
  id                 String    @id @default(cuid())
  code               String    @unique
  name               String
  groupName          String
  printTech          String
  descHuman          String    @db.Text
  descAi             String?   @db.Text // đã bỏ khỏi giao diện, không còn dùng; giữ cột để không mất dữ liệu cũ
  thicknessMm        Float? // độ dày thật (mm); nhóm Mỏng / Cao thành / Dày tính từ số này, xem lib/materials/thickness.ts
  layer1Path         String?   @db.VarChar(500)
  layer2Path         String?   @db.VarChar(500)
  productPhotoPath   String?   @db.VarChar(500)
  referencePath      String?   @db.VarChar(500) // ảnh ghép lớp 1 + lớp 2, đây là ảnh gửi cho AI
  referenceUpdatedAt DateTime?
  kieRefUrl          String?   @db.VarChar(1000) // bộ nhớ đệm URL đã upload lên kie.ai
  kieRefExpiresAt    DateTime?
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)

  // Phân loại (xem docs/DECISIONS.md D73). Các cột *value* lưu "value" của bảng material_options, không dùng khóa ngoại.
  // groupName và printTech vẫn là nguồn mà code cũ đọc: khi lưu, hệ thống ghi song song nhãn của baseMaterial và technique vào hai cột đó.
  baseMaterial         String?            @db.VarChar(60)
  technique            String?            @db.VarChar(60)
  surfaceFinish        String?            @db.VarChar(60) // chất bề mặt: mờ, bóng, gương, nhũ...
  surfacePattern       String?            @db.VarChar(60) // họa tiết: trơn, caro, hoa văn...
  colorCount           ColorCount?
  frontColorName       String?            @db.VarChar(100) // chữ tự do, tả đúng cái nhìn thấy
  frontColorFamily     String?            @db.VarChar(60)
  frontColorConfidence String?            @db.VarChar(20) // CAO | TRUNG_BINH | THAP
  backColorName        String?            @db.VarChar(100)
  backColorFamily      String?            @db.VarChar(60)
  backColorConfidence  String?            @db.VarChar(20)
  seriesCode           String?            @db.VarChar(60) // dòng nhà cung cấp: ZY, HT, H...
  aiVisualNote         String?            @db.Text // 1 câu tiếng Anh tả bề mặt hai mặt cho AI (chưa đưa vào prompt)
  photoIssue           String?            @db.VarChar(200) // vấn đề ảnh mẫu, nối bằng "|": CO_THUOC, CO_TAY, NEN_LAN, MAU_LECH, MO, KHONG_THAY_CHAT_LIEU
  classifyConfidence   String?            @db.VarChar(20) // độ tin cậy của lần phân loại: CAO | TRUNG_BINH | THAP
  needsReview          Boolean            @default(false)
  reviewNote           String?            @db.Text
  styleTags            MaterialStyleTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sheetMaterials  SheetMaterial[]
  selectedIn      SessionSelectedMaterial[]
  generatedImages GeneratedImage[]

  @@index([groupName, isActive])
  @@index([baseMaterial])
  @@index([technique])
  @@index([surfaceFinish])
  @@index([surfacePattern])
  @@index([colorCount])
  @@index([needsReview])
  @@map("materials")
}

// Danh mục giá trị cho các trường phân loại chất liệu (admin thêm/sửa nhãn/tắt). "value" là mã không dấu, không đổi sau khi tạo.
model MaterialOption {
  id        String             @id @default(cuid())
  type      MaterialOptionType
  value     String             @db.VarChar(60)
  label     String             @db.VarChar(100)
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([type, value])
  @@unique([type, label])
  @@index([type, isActive, sortOrder])
  @@map("material_options")
}

// Tag phong cách của chất liệu (nhiều-nhiều). value là value của MaterialOption loại STYLE_TAG.
model MaterialStyleTag {
  materialId String
  value      String   @db.VarChar(60)
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([materialId, value])
  @@index([value])
  @@map("material_style_tags")
}

model Sheet {
  id          String   @id @default(cuid())
  name        String
  groupName   String   @default("")
  cols        Int      @default(2)
  rows        Int      @default(5)
  aspectRatio String   @default("2:3")
  resolution  String   @default("2K")
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // trang mẫu mặc định: dùng cho nút "Tạo nhanh" (không cần chọn trang mẫu)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materials       SheetMaterial[]
  generatedImages GeneratedImage[]

  @@map("sheets")
}

model SheetMaterial {
  id         String @id @default(cuid())
  sheetId    String
  materialId String
  position   Int // 0, 1, 2... theo thứ tự đọc (trái sang phải, trên xuống dưới)

  sheet    Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@unique([sheetId, position])
  @@unique([sheetId, materialId])
  @@index([materialId])
  @@map("sheet_materials")
}

model PromptTemplate {
  id          String     @id @default(cuid())
  kind        PromptKind
  version     Int
  body        String     @db.Text
  isActive    Boolean    @default(false)
  note        String?
  createdById String?
  createdAt   DateTime   @default(now())

  createdBy       User?            @relation(fields: [createdById], references: [id])
  generatedImages GeneratedImage[]

  @@unique([kind, version])
  @@index([kind, isActive])
  @@map("prompt_templates")
}

model DesignStyle {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generatedImages GeneratedImage[]

  @@map("design_styles")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  note        String?  @db.Text
  ownerId     String // sale phụ trách
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     User    @relation("CustomerOwner", fields: [ownerId], references: [id])
  createdBy User    @relation("CustomerCreator", fields: [createdById], references: [id])
  brands    Brand[]

  @@index([name])
  @@index([phone])
  @@index([ownerId])
  @@map("customers")
}

model Brand {
  id          String   @id @default(cuid())
  customerId  String
  name        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])
  logos     Logo[]

  @@index([customerId])
  @@index([name])
  @@map("brands")
}

model Logo {
  id             String    @id @default(cuid())
  brandId        String
  originalPath   String    @db.VarChar(500)
  normalizedPath String    @db.VarChar(500)
  width          Int
  height         Int
  note           String?   @db.Text
  kieUrl         String?   @db.VarChar(1000)
  kieExpiresAt   DateTime?
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  brand     Brand            @relation(fields: [brandId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  sessions  ConsultSession[]

  @@index([brandId])
  @@map("logos")
}

model ConsultSession {
  id                  String      @id @default(cuid())
  type                SessionType
  logoId              String
  parentId            String? // phiên DESIGN trỏ về phiên CATALOG
  productType         String?
  variantsPerMaterial Int?
  note                String?     @db.Text
  createdById         String
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  logo              Logo                      @relation(fields: [logoId], references: [id])
  parent            ConsultSession?           @relation("SessionParent", fields: [parentId], references: [id])
  children          ConsultSession[]          @relation("SessionParent")
  createdBy         User                      @relation(fields: [createdById], references: [id])
  selectedMaterials SessionSelectedMaterial[]
  images            GeneratedImage[]

  @@index([logoId])
  @@index([parentId])
  @@index([createdById, createdAt])
  @@map("consult_sessions")
}

model SessionSelectedMaterial {
  id         String @id @default(cuid())
  sessionId  String
  materialId String

  session  ConsultSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])

  @@unique([sessionId, materialId])
  @@map("session_selected_materials")
}

model GeneratedImage {
  id               String      @id @default(cuid())
  sessionId        String
  kind             ImageKind
  sheetId          String?
  materialId       String?
  designStyleId    String?
  variantIndex     Int         @default(0)
  layoutSnapshot   Json // cột, hàng, danh sách (vị trí, mã, tên chất liệu) lúc tạo
  promptUsed       String      @db.Text
  promptTemplateId String?
  promptVersion    Int?
  model            String
  resolution       String
  aspectRatio      String
  taskId           String?
  status           ImageStatus @default(PENDING)
  attempt          Int         @default(1)
  lastPolledAt     DateTime?
  originalPath     String?     @db.VarChar(500)
  finalPath        String?     @db.VarChar(500)
  errorMessage     String?     @db.Text
  costCredits      Float? // credits nhà cung cấp đã trừ cho ảnh này (nếu có thông tin)
  parentImageId    String?
  createdById      String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  session        ConsultSession   @relation(fields: [sessionId], references: [id])
  sheet          Sheet?           @relation(fields: [sheetId], references: [id])
  material       Material?        @relation(fields: [materialId], references: [id])
  designStyle    DesignStyle?     @relation(fields: [designStyleId], references: [id])
  promptTemplate PromptTemplate?  @relation(fields: [promptTemplateId], references: [id])
  parentImage    GeneratedImage?  @relation("ImageRetry", fields: [parentImageId], references: [id])
  retries        GeneratedImage[] @relation("ImageRetry")
  createdBy      User             @relation(fields: [createdById], references: [id])
  usageLogs      UsageLog[]
  zaloDeliveries ZaloDelivery[]
  zaloPosts      ZaloPost[]

  @@index([status, lastPolledAt])
  @@index([sessionId])
  @@index([createdById])
  @@map("generated_images")
}

model UsageLog {
  id        String    @id @default(cuid())
  userId    String
  imageId   String?
  kind      ImageKind
  day       String    @db.VarChar(10) // YYYY-MM-DD theo múi giờ APP_TIMEZONE
  createdAt DateTime  @default(now())

  user  User            @relation(fields: [userId], references: [id])
  image GeneratedImage? @relation(fields: [imageId], references: [id])

  @@index([userId, day])
  @@index([day])
  @@map("usage_logs")
}

// Nhóm Zalo mà bot được mời vào. chatId là "chat.id" bot nhận được từ webhook (hoặc admin nhập tay).
model ZaloGroup {
  id          String    @id @default(cuid())
  chatId      String    @unique @db.VarChar(100)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  autoSend    Boolean   @default(false) // true = mỗi ảnh tạo xong tự gửi vào nhóm này
  lastSeenAt  DateTime? // lần cuối bot nhận được tin từ nhóm này
  insight     String?   @db.Text // mô tả nhóm (khách là ai, quan tâm gì...) để AI lên kịch bản chăm sóc phù hợp
  careEnabled Boolean   @default(false) // true = AI lên kịch bản chăm sóc cho nhóm này
  postsPerDay Int       @default(2) // số lượt đăng mỗi ngày (2-3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  deliveries ZaloDelivery[]
  posts      ZaloPost[]

  @@map("zalo_groups")
}

// Mỗi ảnh gửi vào mỗi nhóm đúng một dòng (để tự động gửi không bị gửi trùng, và xem được lý do lỗi).
model ZaloDelivery {
  id        String             @id @default(cuid())
  imageId   String
  groupId   String
  status    ZaloDeliveryStatus
  messageId String?            @db.VarChar(100)
  error     String?            @db.Text
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  image GeneratedImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  group ZaloGroup      @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([imageId, groupId])
  @@index([groupId, createdAt])
  @@map("zalo_deliveries")
}

enum ZaloContactRole {
  CUSTOMER // khách nhắn bot (mặc định)
  STAFF // nhân viên/chủ đã ghép nối: dùng được lệnh gõ nhanh
  BLOCKED // bị chặn: lưu tin nhưng bot không trả lời
}

enum ZaloMessageDirection {
  IN
  OUT
}

enum ZaloMessageAuthor {
  CONTACT // người nhắn tới bot
  BOT // bot AI tự trả lời
  HUMAN // nhân viên (tin cũ từ Hộp thư đã bỏ)
  SYSTEM // tin lệnh/ghép nối do hệ thống trả
}

enum ZaloMessageKind {
  TEXT
  IMAGE
  FILE
  VOICE
  STICKER
  OTHER
}

// Mỗi người (hoặc nhóm) đã nhắn cho bot Zalo là một "hội thoại" (lưu để bot đọc ngữ cảnh, ghép nối nhân viên, thống kê).
model ZaloContact {
  id              String          @id @default(cuid())
  chatId          String          @unique @db.VarChar(100)
  chatType        String          @default("PRIVATE") @db.VarChar(20) // PRIVATE | GROUP
  displayName     String          @db.VarChar(150)
  role            ZaloContactRole @default(CUSTOMER)
  pairCode        String?         @db.VarChar(10) // mã ghép nối 4 số đang chờ admin cho phép
  pairRequestedAt DateTime?
  botPaused       Boolean         @default(false) // true = bot im ở hội thoại này (đã chuyển nhân viên hoặc khách gõ /nhanvien)
  botPausedAt     DateTime? // lúc bot bắt đầu im; quá "botResumeHours" thì bot tự trả lời lại
  needsHuman      Boolean         @default(false) // bot bí hoặc khách đòi gặp nhân viên
  unreadCount     Int             @default(0)
  lastMessageAt   DateTime?
  lastMessageText String?         @db.VarChar(200)
  contextResetAt  DateTime? // lệnh /reset: bot không đọc tin cũ hơn mốc này
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  messages ZaloMessage[]

  @@index([lastMessageAt])
  @@index([role])
  @@map("zalo_contacts")
}

model ZaloMessage {
  id               String               @id @default(cuid())
  contactId        String
  direction        ZaloMessageDirection
  author           ZaloMessageAuthor
  kind             ZaloMessageKind      @default(TEXT)
  text             String?              @db.Text
  mediaPath        String?              @db.VarChar(500) // ảnh đã tải về kho lưu trữ
  zaloMessageId    String?              @unique @db.VarChar(100) // chống xử lý trùng khi Zalo gửi lại webhook
  authorUserId     String? // nhân viên trả lời từ web
  failed           Boolean              @default(false)
  error            String?              @db.Text
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime             @default(now())

  contact ZaloContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@index([author, createdAt])
  @@map("zalo_messages")
}

enum ZaloPostKind {
  TEXT
  IMAGE
  VIDEO
}

enum ZaloPostStatus {
  PLANNED // đã lên kịch bản, chờ tới giờ hoặc chờ bấm đăng
  SENDING
  SENT
  FAILED
  SKIPPED // người dùng bỏ qua
}

// Thư viện ảnh/video do người dùng tải lên để dùng trong kịch bản chăm sóc (ví dụ mẫu mã sản phẩm mới).
model ZaloAsset {
  id          String       @id @default(cuid())
  kind        ZaloPostKind // IMAGE hoặc VIDEO
  title       String       @db.VarChar(150)
  description String?      @db.Text // mô tả để AI biết nên dùng khi nào
  path        String       @db.VarChar(500)
  mimeType    String       @db.VarChar(100)
  sizeBytes   Int
  createdById String
  createdAt   DateTime     @default(now())

  posts ZaloPost[]

  @@index([createdAt])
  @@map("zalo_assets")
}

// Một lượt đăng trong kịch bản chăm sóc nhóm Zalo: AI lên sẵn nội dung và giờ, người dùng chỉnh được, rồi đăng.
model ZaloPost {
  id             String         @id @default(cuid())
  groupId        String
  scheduledAt    DateTime
  kind           ZaloPostKind
  text           String         @db.Text
  assetId        String?
  imageId        String? // ảnh đã tạo trong hệ thống (mẫu mã mới)
  status         ZaloPostStatus @default(PLANNED)
  reason         String?        @db.VarChar(300) // vì sao AI chọn nội dung này (trời rét, dịp lễ...)
  error          String?        @db.Text
  sentAt         DateTime?
  aiGenerated    Boolean        @default(true)
  editedAt       DateTime?
  editedByUserId String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  group ZaloGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  asset ZaloAsset?      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  image GeneratedImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  @@index([groupId, scheduledAt])
  @@index([status, scheduledAt])
  @@map("zalo_posts")
}
