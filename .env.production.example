# ==========================================================
# CẤU HÌNH TRÊN VPS. Sao chép file này thành ".env" (cùng thư mục docker-compose.yml) rồi điền giá trị.
# KHÔNG đưa file ".env" lên git và KHÔNG gửi nội dung nó cho người khác.
# ==========================================================

# --- Tên miền (đã trỏ về IP của VPS) ----------------------
# Chỉ tên miền, không có https://. Caddy tự xin chứng chỉ HTTPS cho tên miền này.
DOMAIN="anh-mau.ten-mien-cua-ban.com"
# Địa chỉ công khai của web (có https://). Bắt buộc đúng, nếu không đăng nhập sẽ lỗi.
APP_URL="https://anh-mau.ten-mien-cua-ban.com"
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# --- Cơ sở dữ liệu (MySQL chạy cùng VPS trong Docker) -------
# Tự đặt hai mật khẩu dài, khó đoán (chỉ dùng chữ và số để tránh lỗi ký tự lạ). Đặt một lần rồi đừng đổi.
DB_ROOT_PASSWORD="doi-mat-khau-root-dai-va-kho-doan"
DB_PASSWORD="doi-mat-khau-db-dai-va-kho-doan"

# --- Tài khoản admin đầu tiên (chỉ dùng khi chạy lệnh tạo admin lần đầu) ---
ADMIN_EMAIL="admin@ten-mien-cua-ban.com"
ADMIN_PASSWORD="doi-mat-khau-nay-12345"
ADMIN_NAME="Chủ xưởng"

# --- Kho lưu ảnh -----------------------------------------
# "r2" = ảnh lưu trên Cloudflare R2 (khuyến nghị trên VPS: không cần sao lưu thư mục ảnh, không đầy ổ đĩa).
# "local" = lưu ra thư mục data/storage trên VPS. Hướng dẫn tạo bucket và chuyển ảnh cũ: README, mục "Lưu ảnh trên Cloudflare R2".
STORAGE_DRIVER="r2"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Địa chỉ công khai của bucket, không có dấu / ở cuối. Đổi sang tên miền riêng chỉ cần sửa dòng này.
R2_PUBLIC_URL=""

# --- Tạo ảnh AI ------------------------------------------
# "kie" = gọi kie.ai thật (tính tiền). Để "mock" nếu chỉ muốn chạy thử bằng ảnh giả.
IMAGE_PROVIDER="kie"
KIE_API_KEY="dan-khoa-kie-ai-vao-day"
KIE_API_BASE="https://api.kie.ai"
KIE_UPLOAD_BASE="https://kieai.redpandaai.co"
# Có tên miền HTTPS nên có thể bật callback để ảnh về nhanh hơn (vẫn có hỏi lại định kỳ làm đường chính).
# Bật: đổi thành "true" và dán webhookHmacKey (lấy ở https://kie.ai/settings) vào KIE_CALLBACK_SECRET.
KIE_CALLBACK_ENABLED="false"
KIE_CALLBACK_SECRET=""

# --- Bot Zalo (không bắt buộc) ----------------------------
ZALO_BOT_TOKEN=""
ZALO_API_BASE="https://bot-api.zaloplatforms.com"
ZALO_WEBHOOK_SECRET=""
# Khóa (16 ký tự trở lên) để cron của VPS gọi /api/jobs/zalo-care chạy kịch bản chăm sóc tự động. Bỏ trống = tắt.
# Gọi mỗi 10 phút:  curl -fsS -X POST -H "x-cron-secret: <khóa>" https://tên-miền/api/jobs/zalo-care
ZALO_CARE_CRON_SECRET=""
# Khóa mã hóa cookie của tài khoản Zalo cá nhân (tùy chọn, 16 ký tự trở lên). Bỏ trống thì hệ thống tự sinh và lưu ở data/storage/.secret-key:
# khi đó phải giữ thư mục data/storage (sao lưu cùng ảnh), mất file này thì phải quét QR đăng nhập lại các tài khoản cá nhân.
ZALO_ACCOUNT_KEY=""
