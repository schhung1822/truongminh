# ==========================================================
# CẤU HÌNH ỨNG DỤNG. Sao chép file này thành ".env" rồi điền giá trị.
# KHÔNG đưa file ".env" lên git và KHÔNG gửi nội dung nó cho người khác.
# ==========================================================

# --- Cơ sở dữ liệu MySQL ---------------------------------
# Dạng: mysql://TÊN_USER:MẬT_KHẨU@MÁY_CHỦ:CỔNG/TÊN_CSDL
# Máy dev (chạy MySQL bằng docker-compose.dev.yml): giữ nguyên dòng dưới.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/truongminh"

# --- Địa chỉ web -----------------------------------------
# Địa chỉ công khai của web. Dev: http://localhost:3000. VPS: https://ten-mien-cua-ban.com
# Nếu bắt đầu bằng https:// thì cookie đăng nhập tự bật chế độ an toàn (Secure).
APP_URL="http://localhost:3000"

# Múi giờ dùng để tính "ngày" cho giới hạn lượt tạo ảnh mỗi sale.
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# --- Tài khoản admin đầu tiên (chỉ dùng khi chạy: npm run db:seed) ---
# Sau khi đăng nhập lần đầu hãy đổi mật khẩu. Mật khẩu tối thiểu 8 ký tự.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="doi-mat-khau-nay-12345"
ADMIN_NAME="Chủ xưởng"

# --- Kho lưu ảnh -----------------------------------------
# "local" = lưu ra thư mục trên server (mặc định, hợp khi dev). "r2" = Cloudflare R2: ảnh nằm trên bucket công khai.
STORAGE_DRIVER="local"
# Thư mục này vẫn dùng khi chọn "r2" cho file khóa nhỏ (.secret-key của tài khoản Zalo cá nhân); với "local" nó chứa cả ảnh.
STORAGE_DIR="./storage"

# --- Cloudflare R2 (chỉ cần khi STORAGE_DRIVER="r2") --------
# Mã tài khoản Cloudflare, khóa API R2 (tạo ở R2 > Manage API tokens, quyền Object Read & Write cho đúng bucket).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Tên bucket (một bucket duy nhất, bật truy cập công khai). R2_BUCKET_PUBLIC là tên cũ, vẫn nhận.
R2_BUCKET=""
# Địa chỉ công khai của bucket, không có dấu / ở cuối: https://pub-xxxx.r2.dev hoặc tên miền riêng.
# Đổi sang tên miền riêng sau này chỉ cần sửa dòng này rồi khởi động lại/build lại, không phải sửa code.
R2_PUBLIC_URL=""

# --- Tạo ảnh AI ------------------------------------------
# "mock" = ảnh giả, không tốn tiền (dùng khi dev/test). "kie" = gọi kie.ai thật.
IMAGE_PROVIDER="mock"
# Khóa API của kie.ai. CHỈ cần khi IMAGE_PROVIDER="kie". Tuyệt đối không để lộ ra trình duyệt.
KIE_API_KEY=""
# Địa chỉ API kie.ai (thường không cần đổi).
KIE_API_BASE="https://api.kie.ai"
# Địa chỉ kho upload ảnh tham chiếu của kie.ai (thường không cần đổi).
KIE_UPLOAD_BASE="https://kieai.redpandaai.co"
# Callback (kie.ai báo kết quả về web). Chỉ bật khi APP_URL truy cập được từ internet.
KIE_CALLBACK_ENABLED="false"
# Khóa xác thực chữ ký callback: tạo "webhookHmacKey" ở https://kie.ai/settings rồi dán vào đây.
KIE_CALLBACK_SECRET=""

# --- Bot Zalo: tự gửi ảnh vào nhóm Zalo ---------------------
# Token của bot (tạo bot bằng mini app Zalo Bot Creator). Bỏ trống = tắt tính năng gửi Zalo. KHÔNG để lộ ra trình duyệt.
ZALO_BOT_TOKEN=""
# Địa chỉ API Zalo Bot (thường không cần đổi).
ZALO_API_BASE="https://bot-api.zaloplatforms.com"
# Chuỗi bí mật tự đặt (8-256 ký tự) để xác thực webhook từ Zalo. Cần khi muốn bot tự nhận diện nhóm (webhook cần APP_URL https công khai).
ZALO_WEBHOOK_SECRET=""

# Khóa (16 ký tự trở lên) để máy chủ gọi /api/jobs/zalo-care chạy kịch bản chăm sóc tự động (chỉ dùng trên VPS). Bỏ trống = tắt.
ZALO_CARE_CRON_SECRET=""
# Khóa (16 ký tự trở lên) để máy chủ gọi /api/jobs/fb-retention dọn comment Khác/Spam quá hạn của module Lead Facebook (chỉ dùng trên VPS). Bỏ trống = tắt.
FB_CRON_SECRET=""
# Khóa mã hóa cookie đăng nhập các tài khoản Zalo CÁ NHÂN (16 ký tự trở lên). Bỏ trống = tự sinh file khóa ở storage/.secret-key
# (giữ thư mục storage khi chuyển máy, nếu mất khóa thì phải quét QR đăng nhập lại).
ZALO_ACCOUNT_KEY=""

# --- Pinterest: dùng board/pin đã lưu làm ảnh phong cách tham khảo khi thiết kế -----
# Tạo App ở https://developers.pinterest.com, xin quyền (Trial access) boards:read, pins:read, user_accounts:read
# (thêm boards:read_secret, pins:read_secret nếu có board "Bí mật"). Đăng ký Redirect URI đúng là "<APP_URL>/api/pinterest/oauth/callback".
# Bỏ trống hai biến này = chưa thể kết nối/đồng bộ Pinterest, không ảnh hưởng phần còn lại.
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
# Chỉ bật sau khi App Pinterest đã được cấp boards:read_secret và pins:read_secret.
PINTEREST_INCLUDE_SECRET_BOARDS="false"
# Khóa (16 ký tự trở lên) để máy chủ gọi /api/jobs/pinterest-sync tự động đồng bộ board/pin định kỳ (chỉ dùng trên VPS). Bỏ trống = tắt.
PINTEREST_SYNC_CRON_SECRET=""
