# ==========================================================
# CẤU HÌNH ỨNG DỤNG. Sao chép file này thành ".env" rồi điền giá trị.
# KHÔNG đưa file ".env" lên git và KHÔNG gửi nội dung nó cho người khác.
# ==========================================================

# --- Cơ sở dữ liệu MySQL ---------------------------------
# Dạng: mysql://TÊN_USER:MẬT_KHẨU@MÁY_CHỦ:CỔNG/TÊN_CSDL
# Máy dev (chạy MySQL bằng docker-compose.dev.yml): giữ nguyên dòng dưới.
DATABASE_URL="mysql://root:root@127.0.0.1:3306/truongminh"

# --- Địa chỉ web -----------------------------------------
# Địa chỉ công khai của web. Dev: http://localhost:3000. VPS: https://ten-mien-cua-ban.com
# Nếu bắt đầu bằng https:// thì cookie đăng nhập tự bật chế độ an toàn (Secure).
APP_URL="http://localhost:3000"

# Múi giờ dùng để tính "ngày" cho giới hạn lượt tạo ảnh mỗi sale.
APP_TIMEZONE="Asia/Ho_Chi_Minh"

# --- Tài khoản admin đầu tiên (chỉ dùng khi chạy: npm run db:seed) ---
# Sau khi đăng nhập lần đầu hãy đổi mật khẩu. Mật khẩu tối thiểu 8 ký tự.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="doi-mat-khau-nay-12345"
ADMIN_NAME="Chủ xưởng"

# --- Kho lưu ảnh -----------------------------------------
# "local" = lưu ra thư mục trên server (mặc định). Sau này có thể đổi sang "s3".
STORAGE_DRIVER="local"
# Thư mục lưu ảnh khi dùng "local". Nằm NGOÀI thư mục public. Trên VPS phải là thư mục được sao lưu.
STORAGE_DIR="./storage"

# --- Tạo ảnh AI ------------------------------------------
# "mock" = ảnh giả, không tốn tiền (dùng khi dev/test). "kie" = gọi kie.ai thật.
IMAGE_PROVIDER="mock"
# Khóa API của kie.ai. CHỈ cần khi IMAGE_PROVIDER="kie". Tuyệt đối không để lộ ra trình duyệt.
KIE_API_KEY=""
# Địa chỉ API kie.ai (thường không cần đổi).
KIE_API_BASE="https://api.kie.ai"
# Địa chỉ kho upload ảnh tham chiếu của kie.ai (thường không cần đổi).
KIE_UPLOAD_BASE="https://kieai.redpandaai.co"
# Callback (kie.ai báo kết quả về web). Chỉ bật khi APP_URL truy cập được từ internet.
KIE_CALLBACK_ENABLED="false"
# Khóa xác thực chữ ký callback: tạo "webhookHmacKey" ở https://kie.ai/settings rồi dán vào đây.
KIE_CALLBACK_SECRET=""
